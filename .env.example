# --- Neo4j (required) ---
NEO4J_URI=bolt://localhost:7687
NEO4J_USER=neo4j
NEO4J_PASSWORD=

# --- External OpenAI-compatible inference (required) ---
# One LiteLLM gateway serves both /chat/completions and /embeddings. Project
# run_servers.sh checks model availability; launchers require these inputs.
# No repository script starts generation or embedding model processes.
RAG_INFERENCE_BASE_URL=
RAG_INFERENCE_API_KEY=

# Paper configuration: model aliases registered on the shared gateway. A different model is
# a different experiment and must use a separate run ID and reported policy.
RAG_GENERATION_MODEL=gemma-4-31b-it
RAG_EMBEDDING_MODEL=qwen3-embedding-4b
# Declared serving-capacity metadata. These values do not configure the server
# or establish observed capacity, utilization, or a shared request limit.
RAG_GENERATION_MAX_NUM_SEQS=120
RAG_EMBEDDING_MAX_NUM_SEQS=512
# --- Optional LLM-as-a-judge analysis ---
# Deterministic/official metrics are the default paper path. Enable the judge
# explicitly. Paper mode uses only the same LiteLLM gateway and prohibits the
# public OpenAI Batch route.
RAG_JUDGE_ENABLED=false
# EVAL_MODEL must be registered on the same LiteLLM gateway.
EVAL_MODEL=
RAG_JUDGE_BATCH=false

# --- Retrieval / chunking settings (see docs/ARCHITECTURE.md) ---
NEO4J_VECTOR_DIMENSIONS=2560
# Per-process client ceiling; a selected execution profile takes precedence.
RAG_GENERATION_CONCURRENCY=30
RAG_INFERENCE_RETRY_ATTEMPTS=5
RAG_INFERENCE_TIMEOUT=600
# Generation and embedding share the configured gateway. Cross-process limits
# require the queue wrapper or a supervisor that owns that queue.
RAG_EMBEDDING_BATCH_SIZE=16
RAG_MAX_CONCURRENT_EMBEDDING_REQUESTS=1
# Adapter-specific producer limits apply to one target process. They do not
# reserve server capacity or imply the same number of simultaneous requests.
RAG_MAX_PARALLEL_FILES=64
RAG_HOP_DOC_WORKERS=10
RAG_HOP_GATHER_WAVE=64
RAG_HOP_BUILD_CONCURRENCY=4
RAG_OFFICIAL_QUERY_TIMEOUT=1800
RAG_OFFICIAL_EMBED_TIMEOUT=600
RAG_EMBEDDING_CACHE=on
# Paper endpoint input capacities: Gemma 256k, Qwen embeddings 32k.
RAG_MAX_CONTEXT_LENGTH=262144
MAX_EMBEDDING_LENGTH=32768
EMBEDDING_QUERY_INSTRUCTION="Given a web search query, retrieve relevant passages that answer the query"
NEO4J_FULLTEXT_ANALYZER=english

# --- Method ablations ---
RAG_ABLATION_Q_PLUS=True
RAG_ABLATION_Q_MINUS=True
# Experimental fine-grained retrieval nodes; results collapse to the existing
# fixed-size chunk before ranking and answer synthesis.
RAG_SENTENCE_CHANNEL_ENABLED=false
# Index-time schema: legacy, grounded_v1, or the experimental linked_v2
# grounded-answer continuation schema. Use a distinct corpus tag when changed.
RAG_QUESTION_SCHEMA=legacy
RAG_QPLUS_HOP_ACTIVATION=owner
RAG_CONTINUATION_EDGES_ENABLED=false
RAG_HOP_SEED_POLICY=all
RAG_HOP_SEMANTIC_VARIANT=body_only
RAG_PRECOMPUTE_RECIPROCAL_HOPS=true
RAG_HYPO_CHANNEL_VARIANT=full
RAG_GRAPH_HOP_DEPTH=1
RAG_GRAPH_PATH_DECAY=0.5
RAG_HOP_EDGE_FILTER=none
RAG_GRAPH_EDGE_VARIANT=full
RAG_SOURCE_SELECTION_VARIANT=role_body_list_ranking
RAG_FINAL_RANK_VARIANT=fused
RAG_CANDIDATE_ORDER_INPUT_ORDER=search
# Deterministic seed used only for the hash-shuffled diagnostic order.
RAG_CANDIDATE_ORDER_SHUFFLE_SEED=0
# Diagnostic only: JSONL capture of frozen list-ordering candidate pools.
# RAG_CANDIDATE_ORDER_TRACE_PATH=data/results/diagnostics/frozen_candidate_pools.jsonl
RAG_CANDIDATE_POOL_MULTIPLIER=1

# --- Quick-start execution settings ---
# Registry fallback benchmark concurrency is 1; this example selects 4.
# index-shared-120.json selects 8 and requires an owning shared queue.
RAG_BENCHMARK_CONCURRENCY=4
RAG_BENCHMARK_CHECKPOINT_EVERY=10
# This seed applies outside paper mode. Paper launchers omit generation seeds;
# RAG_BENCHMARK_SEEDS remains the separate evaluation/sampling seed.
RAG_LLM_SEED=42
RAG_BENCHMARK_SEEDS=42

# --- Method-defining external artifacts (required for the named strategy) ---
# GFM-RAG's checkpoint/configuration and local entity-linker snapshots
# are fetched at the pinned revisions in configs/paper_runtime_requirements.json.
# scripts/setup_official_baselines.sh --primary also installs HopRAG's main/POS
# environments. See docs/RUNTIME_REQUIREMENTS.md for paths and individual setup.
# Only core/strategy_registry.py defines supported methods.

# Optional content-bound throughput profile. Export an absolute path before Python starts.
# A profile records request and producer bounds; it is not runtime-readiness evidence.
# RAG_EXECUTION_PROFILE=/absolute/path/selected-profile.json
# For one combined generation/embedding pool, select index-shared-120.json (v3).
# Campaign supervisors own the queue; individual foreground targets use
# scripts/run_with_inference_queue.py. Do not manually set RAG_QUEUE_* variables.

# Prehop saves full stage payloads, HTTP bodies, and document intermediates by default.
# Keep custom trace directories outside version-controlled exports.
# RAG_PREHOP_TRACE=true
# RAG_PREHOP_TRACE_DIR=/absolute/path/to/local/prehop-traces
