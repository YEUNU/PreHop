# Neo4j connection
NEO4J_URI=bolt://localhost:7687
NEO4J_USER=neo4j
NEO4J_PASSWORD=

# One external LiteLLM gateway serves generation and embeddings.
# Fill in the endpoint and key; run_servers.sh checks model availability.
# No repository script starts model processes.
RAG_INFERENCE_BASE_URL=
RAG_INFERENCE_API_KEY=
RAG_GENERATION_MODEL=gemma-4-31b-it
RAG_EMBEDDING_MODEL=qwen3-embedding-4b
NEO4J_VECTOR_DIMENSIONS=2560

# Quick-start concurrency overrides. Defaults and shared queue profiles are
# documented in docs/THROUGHPUT_EXECUTION.md.
RAG_MAX_PARALLEL_FILES=64
RAG_BENCHMARK_CONCURRENCY=4
# Applies outside paper mode; paper launchers omit generation seeds.
RAG_LLM_SEED=42

# Other request settings use core/inference_transport.py and registry defaults.
# See docs/RUNTIME_REQUIREMENTS.md for timeouts, retry budgets and model runtimes;
# see docs/ARCHITECTURE.md for method settings and ablation profiles.
# Deterministic dataset metrics are enabled by default. Optional judge analysis:
# RAG_JUDGE_ENABLED=true
# EVAL_MODEL=<model-registered-on-the-same-gateway>

# Export an absolute profile path before Python starts to select shared limits.
# RAG_EXECUTION_PROFILE=/absolute/path/selected-profile.json
# Queue-owning supervisors or scripts/run_with_inference_queue.py set RAG_QUEUE_*.
# Prehop writes full stage traces under ignored data directories by default.
