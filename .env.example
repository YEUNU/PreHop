# --- Neo4j (required) ---
NEO4J_URI=bolt://localhost:7687
NEO4J_USER=neo4j
NEO4J_PASSWORD=

# --- External OpenAI-compatible inference (required) ---
# These must point to services on another host. Project scripts only validate
# them and never launch generation or embedding model processes.
VLLM_URL=
VLLM_EMBED_URL=
VLLM_API_KEY=EMPTY

# vLLM --served-model-name values
VLLM_SERVED_MODEL_NAME=generation-model
VLLM_SERVED_EMBED_MODEL_NAME=embedding-model
# Capacity of the external inference server. This is recorded in experiment
# manifests; it does not launch or configure a local model process.
VLLM_MAX_NUM_SEQS=120
# Use separate when the two model names route to different accelerator servers,
# even if both URLs are the same API gateway. Use shared only when they compete
# for one scheduler; auto infers this from URL equality.
RAG_INFERENCE_CAPACITY_MODE=auto
VLLM_GENERATION_MAX_NUM_SEQS=120
VLLM_EMBED_MAX_NUM_SEQS=120

# --- Optional LLM-as-a-judge analysis ---
# Deterministic/official metrics are the default paper path. Enable the judge
# explicitly; when enabled, Batch is the default/cheap transport.
RAG_JUDGE_ENABLED=false
# EVAL_MODEL must support /v1/chat/completions in the OpenAI Batch API.
OPENAI_API_KEY=
EVAL_MODEL=
RAG_JUDGE_BATCH=true
RAG_JUDGE_BATCH_POLL_SECONDS=15

# --- Retrieval / chunking settings (paper appendix) ---
NEO4J_VECTOR_DIMENSIONS=2560
# One global request limit per target process/event loop (not per document).
MAX_CONCURRENT_LLM_CALLS=120
# These are single-target defaults. The matrix runner budgets them across its
# width and generation-heavy width. Explicit separate-server mode keeps two
# independent limits even when both models sit behind one gateway URL.
RAG_EMBEDDING_BATCH_SIZE=32
RAG_MAX_CONCURRENT_EMBEDDING_REQUESTS=2
# The matrix runner clamps these adapter-specific settings to the active
# strategy-phase budget. The per-target generation budget is the configured
# generation capacity divided by the active generation-heavy target width.
# With the current two-dataset matrix and max_num_seqs=120, each target receives
# at most 60 generation calls; do not rely on these raw defaults for aggregate
# capacity.
RAG_MAX_PARALLEL_FILES=64
RAG_HOP_DOC_WORKERS=30
RAG_HOP_MAX_THREADS=4
RAG_MS_CONCURRENT_REQUESTS=120
RAG_HOP_QUESTION_RETRIES=3
RAG_HOP_GATHER_WAVE=64
RAG_EMBEDDING_CACHE=on
# Change this when a served embedding model changes without changing its model name.
RAG_EMBEDDING_REVISION=
RAG_MAX_CONTEXT_LENGTH=16384
MAX_EMBEDDING_LENGTH=16384
NEO4J_FULLTEXT_ANALYZER=english

# --- Method ablations ---
RAG_ABLATION_Q_PLUS=True
RAG_ABLATION_Q_MINUS=True
RAG_HYPO_CHANNEL_VARIANT=full
RAG_GRAPH_HOP_DEPTH=1
RAG_SOURCE_SELECTION_VARIANT=round_robin

# --- Reproducibility ---
# RAG_LLM_SEED=42
# RAG_BENCHMARK_SEEDS=0,1,2,3,4
