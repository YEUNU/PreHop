# --- Neo4j (required) ---
NEO4J_URI=bolt://localhost:7687
NEO4J_USER=neo4j
NEO4J_PASSWORD=

# --- External OpenAI-compatible inference (required) ---
# These must point to services on another host. Project scripts only validate
# them and never launch generation or embedding model processes.
VLLM_URL=
VLLM_EMBED_URL=
VLLM_API_KEY=EMPTY

# vLLM --served-model-name values
VLLM_SERVED_MODEL_NAME=generation-model
VLLM_SERVED_EMBED_MODEL_NAME=embedding-model
# Capacity of the external inference server. This is recorded in experiment
# manifests; it does not launch or configure a local model process.
VLLM_MAX_NUM_SEQS=128

# --- LLM-as-a-judge (OpenAI Batch API is the default/cheap path) ---
# EVAL_MODEL must support /v1/chat/completions in the OpenAI Batch API.
OPENAI_API_KEY=
EVAL_MODEL=
RAG_JUDGE_BATCH=true
RAG_JUDGE_BATCH_POLL_SECONDS=15

# --- Retrieval / chunking settings (paper appendix) ---
NEO4J_VECTOR_DIMENSIONS=2560
# One global request limit per target process/event loop (not per document).
MAX_CONCURRENT_LLM_CALLS=30
# These are single-target defaults. The matrix runner budgets them across its
# width: separate URLs get independent limits; one shared generation/embedding
# URL is adjusted to a combined <= VLLM_MAX_NUM_SEQS bound before launch.
RAG_EMBEDDING_BATCH_SIZE=32
RAG_MAX_CONCURRENT_EMBEDDING_REQUESTS=2
RAG_HOP_QUESTION_RETRIES=3
RAG_HOP_LINK_LIMIT=5
RAG_HOP_CANDIDATE_LIMIT=15
# Minimum ANN over-fetch. Each source raises this only by its own node/question
# count so post-ANN cross-document filtering can still retain 15 candidates.
RAG_HOP_ANN_POOL=50
RAG_HOP_SAME_NEED_WEIGHT=0.5
RAG_HOP_GATHER_WAVE=64
RAG_HOP_CHANNEL_CONCURRENCY=2
RAG_GRAPH_SEARCH_LIMIT=20
RAG_MAX_CONTEXT_LENGTH=16384
MAX_EMBEDDING_LENGTH=16384
NEO4J_FULLTEXT_ANALYZER=english

# --- Paper ablations (retained because they are measured experiments) ---
RAG_ABLATION_Q_PLUS=True
RAG_ABLATION_Q_MINUS=True

# --- Fixed-size chunking (core-only rewrite) ---
# RAG_CHUNK_SENTENCES=6
# RAG_MIN_CHUNK_SENTENCES=2

# --- Reproducibility ---
# RAG_LLM_SEED=42
# RAG_BENCHMARK_SEEDS=0,1,2,3,4
