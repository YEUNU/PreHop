# Public source: code, tests, configs, .env.example, uv.lock and the four
# public Markdown guides. Manuscript, figures sources, data and agent state stay local.

# Python
__pycache__/
*.py[cod]
.pytest_cache/
.ruff_cache/

# Environments and secrets
.venv*/
.env
.env.*
!.env.example
*.pem
*.key
credentials.json
secrets.json

# Local data, services and run outputs
/data/
/neo4j_data/
/logs/
/artifacts/
*.log
*.tmp
.DS_Store

# Manuscript, figure sources and local exports
/docs/*
!/docs/figures/
/fig/

# Markdown: only the public guides
*.md
!/README.md
!/docs/METHOD.md
!/docs/SETUP.md
!/docs/REPRODUCING.md

# Agent state
/AGENTS.*
/CLAUDE.*
.claude/
.codex/
.agents/
/.mcp*.json
