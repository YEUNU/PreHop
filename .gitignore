# Public source: code, tests, configs, .env.example, uv.lock and the four
# public Markdown guides. Manuscript, figures sources, data and agent state stay local.

# Python
__pycache__/
*.py[cod]
*.egg-info/
build/
dist/
.pytest_cache/
.ruff_cache/
.mypy_cache/
.coverage
htmlcov/
.ipynb_checkpoints/

# Environments and secrets
.venv/
.venv*/
venv/
.env
.env.*
!.env.example
*.pem
*.key
credentials.json
secrets.json

# Local data, services and run outputs
/data/
/neo4j_data/
/logs/
/artifacts/
/output/
/tmp/
*.log
*.tmp
.DS_Store

